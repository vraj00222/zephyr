# Copy to .env.local and fill in when the backend exists.
# Leave unset to run the built-in simulation (demo mode).

# Base URL of the Zéphyr backend, no trailing slash, e.g. http://localhost:8000
ZEPHYR_BACKEND_URL=

# Optional bearer token; sent as "Authorization: Bearer <key>" on every proxied request
ZEPHYR_BACKEND_KEY=
